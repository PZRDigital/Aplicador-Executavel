#include "resource.h"
#include <winres.h>

// A interface compilada (CharSelectPanorama\bin\Release\d3d9.dll) vai dentro do aplicador
IDR_INTERFACE RCDATA "..\\CharSelectPanorama\\bin\\Release\\d3d9.dll"
IDI_APP ICON "icone.ico"
IDR_LOGO RCDATA "logo.png"
IDR_FUNDO RCDATA "fundo.jpg"
IDR_FONTE_TITULO RCDATA "..\\CharSelectPanorama\\dist\\charselect\\fonts\\Cinzel.ttf"
IDR_FONTE_TEXTO RCDATA "..\\CharSelectPanorama\\dist\\charselect\\fonts\\Inter.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "NexusRO"
            VALUE "FileDescription", "Aplicador da interface NexusRO"
            VALUE "FileVersion", "1.1"
            VALUE "ProductName", "Aplicador NexusRO"
            VALUE "ProductVersion", "1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END
